# ==============================================================================
# DevOps Quest - Environment Variable Template
# Copy this file to .env for local development:
#   cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Flask environment: 'development', 'testing', or 'production'
FLASK_ENV=development

# Safe debug flag: strictly 0 in production; set to 1 only during local debugging
FLASK_DEBUG=0

# Secret key for session security (generate a secure random 32+ byte string in production)
SECRET_KEY=dev-insecure-secret-key-change-in-production

# Path to the SQLite database file
DATABASE_PATH=instance/devops_quest.db

# Server network binding configuration
PORT=5000
HOST=0.0.0.0

